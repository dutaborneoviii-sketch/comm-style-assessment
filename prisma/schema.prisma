generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Department {
  name  String @id
  users User[]
}

model User {
  id               String          @id @default(cuid())
  name             String?
  npp              String?         @unique
  email            String?         @unique
  emailVerified    DateTime?
  image            String?         @db.Text
  password         String?
  workUnit         String?
  employeeLocation String?
  department       String?
  departmentRel    Department?     @relation(fields: [department], references: [name], onDelete: SetNull)
  pangkat          String?
  positionDetail   String?
  accounts         Account[]
  sessions         Session[]
  assessments      Assessment[]
  coachLogs        CoachingLog[]   @relation("CoachLogs")
  coacheeLogs      CoachingLog[]   @relation("CoacheeLogs")
  role             String          @default("USER")
  status           String          @default("PENDING")
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  passwordUpdatedAt DateTime       @default(now())
  loginLogs        LoginActivity[]
}

model CoachingLog {
  id              String       @id @default(cuid())
  coachId         String
  coacheeId       String
  date            DateTime
  title           String
  notes           String       @db.Text
  actionItems     ActionItem[]
  response        String?      @db.Text
  nextSessionDate DateTime?
  isClosed        Boolean      @default(false)
  isDraft         Boolean      @default(false)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  coach   User @relation("CoachLogs", fields: [coachId], references: [id], onDelete: Cascade)
  coachee User @relation("CoacheeLogs", fields: [coacheeId], references: [id], onDelete: Cascade)
}

model ActionItem {
  id            String      @id @default(cuid())
  coachingLogId String
  text          String      @db.Text
  dueDate       DateTime?
  followUpNotes String?     @db.Text
  evidenceUrl   String?     @db.Text
  evidenceName  String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  coachingLog   CoachingLog @relation(fields: [coachingLogId], references: [id], onDelete: Cascade)
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime
  @@unique([identifier, token])
}

model Assessment {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  countA         Int
  countB         Int
  countC         Int
  countD         Int
  primaryStyle   String
  secondaryStyle String?
  isCombination  Boolean  @default(false)
  createdAt      DateTime @default(now())
}

model Question {
  id        String   @id @default(cuid())
  order     Int
  text      String   @db.Text
  isActive  Boolean  @default(true)
  options   Option[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Option {
  id         String   @id @default(cuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  letter     String
  text       String   @db.Text
}

model FeatureFlag {
  id          String   @id @default(cuid())
  featureKey  String
  roleGroup   String
  department  String   @default("GLOBAL")
  location    String   @default("GLOBAL")
  enabled     Boolean  @default(false)
  label       String
  description String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@unique([featureKey, roleGroup, department, location])
}

model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CommunicationDictionary {
  id        String   @id
  content   String   @db.LongText
  updatedAt DateTime @updatedAt
}

model LoginActivity {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ipAddress String?
  userAgent String?  @db.Text
  location  String?
  action    String?  @default("LOGIN")
  details   String?  @db.Text
  createdAt DateTime @default(now())
}
