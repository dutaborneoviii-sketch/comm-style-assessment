# Gunakan string koneksi ini untuk menghubungkan aplikasi ke SQL Server di PC tujuan.
# Ganti localhost, NamaDatabaseAnda, UsernameSQL, dan PasswordSQL sesuai konfigurasi PC tersebut.

DATABASE_URL="sqlserver://localhost:1433;database=NamaDatabaseAnda;user=UsernameSQL;password=PasswordSQL;encrypt=true"
